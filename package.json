{
  "name": "anim-studio",
  "version": "1.1.0",
  "description": "Astra plugin: install your own avatar animations and choose when she plays them",
  "license": "MIT",
  "author": "Taill",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun install --frozen-lockfile && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js && bun run build:editor",
    "build:editor": "esbuild ui/editor/main.js --bundle --format=iife --minify --target=es2020 --legal-comments=eof --outfile=ui/editor.js",
    "pretest": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:astra-plugin-sdk --outfile=dist/plugin.cjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "astra-plugin-sdk": "^0.7.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "3.3.3",
    "@pixiv/three-vrm-animation": "3.3.3",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "three": "0.169.0",
    "typescript": "^5.4.0"
  }
}
